<Page x:Class="OpenReg_Lite.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenReg_Lite"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserPage"
      Loaded="Page_Loaded">

    <Grid Background="#f0dcc4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="67"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ваш номер:"
                           FontSize="30"
                           VerticalAlignment="Bottom"
                           Margin="5,0,0,0"/>
                <TextBlock Foreground="#ac7c4c" Text="Не выбран" Margin="5,0,5,0" x:Name="TextNum" Grid.Row="1" Background="White" FontSize="50"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Ведите свой логин" FontSize="25" VerticalAlignment="Bottom" Margin="5,0,0,0"/>
                    <TextBox x:Name="Nameee" Margin="5,0,0,0" Height="35"/>
                </StackPanel>
                <Button Click="Button_Click" Content="Забронировать" FontSize="50" Grid.Row="1" Margin="5,0,0,0"/>
            </Grid>
            <DataGrid Margin="5,5,0,0" Grid.Row="0" x:Name="UserDataGrid"
          AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер Комнаты" Width="*" Binding="{Binding Number}"/>
                    <DataGridTextColumn Header="Количество Комнат" Width="*" Binding="{Binding NumberOfRooms}"/>
                    <DataGridTextColumn Header="Стоимость" Width="*" Binding="{Binding CostM}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


        </Grid>

    </Grid>
</Page>
