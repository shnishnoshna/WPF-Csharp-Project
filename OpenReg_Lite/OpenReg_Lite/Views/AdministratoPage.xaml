<Page x:Class="OpenReg_Lite.Views.AdministratoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenReg_Lite.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdministratoPage">

    <Grid Background="#FFC1AB90">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- боковая левая -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
        </Grid.RowDefinitions>
            <Button Content="" BorderThickness="0" Click="Button_Click">
                <Button.Background>
                    <ImageBrush ImageSource="D:\KURSTUTUOR\OpenReg_Lite\OpenReg_Lite\Images\exit.png" Stretch="Uniform" Opacity="0.8"/>
                </Button.Background>
            </Button>
            <Button Content="" BorderThickness="0" Grid.Row="1" Click="Button_Click_2">
                <Button.Background>
                    <ImageBrush ImageSource="D:\KURSTUTUOR\OpenReg_Lite\OpenReg_Lite\Images\User.png" Stretch="Uniform" Opacity="0.8"/>
                </Button.Background>
            </Button>
            <Button Content="" BorderThickness="0" Grid.Row="2" Click="Button_Click_3">
                <Button.Background>
                    <ImageBrush ImageSource="D:\KURSTUTUOR\OpenReg_Lite\OpenReg_Lite\Images\Worker.png" Stretch="Uniform" Opacity="0.8"/>
                </Button.Background>
            </Button>
            <Button Content="" BorderThickness="0" Grid.Row="3" Click="Button_Click_4">
                <Button.Background>
                    <ImageBrush ImageSource="D:\KURSTUTUOR\OpenReg_Lite\OpenReg_Lite\Images\Pen.png" Stretch="Uniform" Opacity="0.8"/>
                </Button.Background>
            </Button>
            <Button Content="" BorderThickness="0" Grid.Row="4" Click="Button_Click_1">
                <Button.Background>
                    <ImageBrush ImageSource="D:\KURSTUTUOR\OpenReg_Lite\OpenReg_Lite\Images\Room.png" Stretch="Uniform" Opacity="0.8"/>
                </Button.Background>
            </Button>
            <Button Content="" BorderThickness="0" Grid.Row="5" Click="Button_Click_5">
                <Button.Background>
                    <ImageBrush ImageSource="D:\KURSTUTUOR\OpenReg_Lite\OpenReg_Lite\Images\Money.png" Stretch="Uniform" Opacity="0.8"/>
                </Button.Background>
            </Button>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="1" Background="#FFD0BEA8">
            
            <Grid Grid.Column="1" Background="green">
                <Frame x:Name="FrameReg"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
