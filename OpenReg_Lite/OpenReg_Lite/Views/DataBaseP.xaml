<Page x:Class="OpenReg_Lite.Views.DataBaseP"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenReg_Lite.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DataBaseP"
      Loaded="Page_Loaded">

    <Grid Background="#f0dcc4">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Button Background="#b06c58" Height="25" Width="56"
                HorizontalAlignment="Left" 
                VerticalAlignment="Center" 
                Margin="5,0,0,0"
                Content="Выйти"
                Click="Button_Click"/>
        <Button Grid.Row="2" Height="25"
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,5,0"
                Background="#b06c58"
                Content="Удалить"
                Click="Del_Button"/>
        <DataGrid Grid.Row="1" x:Name="UserDataGrid"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="*" Binding="{Binding ID}"/>
                <DataGridTextColumn Header="Логин" Width="*" Binding="{Binding Login}"/>
                <DataGridTextColumn Header="Пароль" Width="*" Binding="{Binding Password}"/>
                <DataGridTextColumn Header="Роль" Width="*" Binding="{Binding RoleUs.Title}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
