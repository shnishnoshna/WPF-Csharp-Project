<Page x:Class="OpenReg_Lite.RegisrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenReg_Lite"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisrPage">
    
        <Grid Background="#f0dcc4">
        
        <Grid MaxWidth="240" MaxHeight="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Grid.Row="6" Height="25" Width="150"
                    Background="#b06c58"
                    Content="Назад"
                    FontSize="15"
                    Click="Button_Click_3"/>
            <Grid Grid.Column="1" Grid.Row="1">
                <Rectangle Grid.Row="1" Grid.Column="1" Fill="White" Panel.ZIndex="-2"/>
                <TextBox x:Name="TR" Grid.Row="1" Grid.Column="1" Background="Transparent" VerticalContentAlignment="Center" TextChanged="TR_TextChanged"  BorderThickness ="0.5"/>
                <TextBlock x:Name="TRF" Text="Login" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#ac7c4c" Margin="4,0,0,0" Panel.ZIndex="-1"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" BorderThickness ="0" Content="X" Background="Transparent" Foreground="#53433a" Click= "Button_Click"/>
                </Grid>
                
            </Grid>
            <Grid Grid.Column="1" Grid.Row="3">
                <Rectangle Grid.Row="1" Grid.Column="1" Fill="White" Panel.ZIndex="-2"/>
                <TextBox x:Name="TRP" Grid.Row="1" Grid.Column="1" Background="Transparent" VerticalContentAlignment="Center" TextChanged="TRP_TextChanged"  BorderThickness ="0.5"/>
                <TextBlock x:Name="TRFP" Text="Password" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#ac7c4c" Margin="4,0,0,0" Panel.ZIndex="-1"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" BorderThickness ="0" Content="X" Background="Transparent" Foreground="#53433a" Click="Button_Click_1"/>

                </Grid>
            </Grid>
            
            <ComboBox Grid.Column="1" Grid.Row="4" Height="40"
                      x:Name="ComboBox"
                      DisplayMemberPath="Title"/>
            <Grid Grid.Column="1" Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" BorderThickness="0" Margin="5,0,10,0" Background="#d7bbaa" Content="Регистрация" FontSize="15" Click="Button_Click_2"/>
                
            </Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

        </Grid>

    </Grid>
    
</Page>
